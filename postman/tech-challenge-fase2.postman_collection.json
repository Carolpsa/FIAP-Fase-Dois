            },
            "url": "{{baseUrl}}/itens-cardapio"
          }
        },
        {
          "name": "Buscar tipo de usuário inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"]
