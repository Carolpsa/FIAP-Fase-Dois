              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cantina da Nona - Unidade Centro\",\n  \"endereco\": \"Rua das Flores, 123 - Centro\",\n  \"tipoCozinha\": \"Italiana\",\n  \"horarioFuncionamento\": \"Todos os dias, das 11h às 23h\",\n  \"donoId\": {{usuarioDonoId}}\n}"
            },
            "url": "{{baseUrl}}/restaurantes/{{restauranteId}}"
          }
        }
      ]
    },
    {
      "name": "4 - Itens do Cardápio",
      "item": [
        {
          "name": "Cadastrar item do cardápio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('itemId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Lasanha à bolonhesa\",\n  \"descricao\": \"Lasanha caseira com molho bolonhesa e queijo gratinado\",\n  \"preco\": 49.90,\n  \"disponivelApenasNoLocal\": false,\n  \"caminhoFoto\": \"/imagens/pratos/lasanha.jpg\",\n  \"restauranteId\": {{restauranteId}}\n}"
            },
            "url": "{{baseUrl}}/itens-cardapio"
          }
        },
        {
          "name": "Listar todos os itens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/itens-cardapio"
          }
        },
        {
          "name": "Listar itens de um restaurante",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tem pelo menos 1 item', () => pm.expect(pm.response.json().length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/itens-cardapio?restauranteId={{restauranteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["itens-cardapio"],
              "query": [{ "key": "restauranteId", "value": "{{restauranteId}}" }]
            }
          }
        },
        {
          "name": "Buscar item por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/itens-cardapio/{{itemId}}"
          }
        },
        {
          "name": "Atualizar item do cardápio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Lasanha à bolonhesa (grande)\",\n  \"descricao\": \"Serve 2 pessoas\",\n  \"preco\": 79.90,\n  \"disponivelApenasNoLocal\": true,\n  \"caminhoFoto\": \"/imagens/pratos/lasanha-grande.jpg\",\n  \"restauranteId\": {{restauranteId}}\n}"
            },
            "url": "{{baseUrl}}/itens-cardapio/{{itemId}}"
          }
        }
      ]
    },
    {
      "name": "5 - Cenários de erro (regras de negócio)",
      "item": [
        {
          "name": "Restaurante com dono que é Cliente (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 422', () => pm.response.to.have.status(422));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Restaurante Inválido\",\n  \"endereco\": \"Rua X, 1\",\n  \"tipoCozinha\": \"Japonesa\",\n  \"horarioFuncionamento\": \"Todos os dias\",\n  \"donoId\": {{usuarioClienteId}}\n}"
            },
            "url": "{{baseUrl}}/restaurantes"
          }
        },
        {
          "name": "Excluir restaurante que tem itens (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 422', () => pm.response.to.have.status(422));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/restaurantes/{{restauranteId}}"
          }
        },
        {
          "name": "Excluir usuário que é dono de restaurante (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 422', () => pm.response.to.have.status(422));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/usuarios/{{usuarioDonoId}}"
          }
        },
        {
          "name": "Item com preço negativo (400)",
          "event": [
