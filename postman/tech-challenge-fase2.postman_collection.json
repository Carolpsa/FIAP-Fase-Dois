              "raw": "{\n  \"nome\": \"Cantina da Nona\",\n  \"endereco\": \"Rua das Flores, 123 - Centro\",\n  \"tipoCozinha\": \"Italiana\",\n  \"horarioFuncionamento\": \"Terça a Domingo, das 11h às 23h\",\n  \"donoId\": {{usuarioDonoId}}\n}"
            },
            "url": "{{baseUrl}}/restaurantes"
          }
        },
        {
          "name": "Listar restaurantes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]
